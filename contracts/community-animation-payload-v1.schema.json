{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meshy2aurora.local/contracts/community-animation-payload-v1.schema.json",
  "title": "Meshy2Aurora portable animation payload V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","durationSeconds","animationRootBoneName","tracks","events"],
  "properties": {
    "schemaVersion": {"const":1},
    "durationSeconds": {"type":"number","exclusiveMinimum":0,"maximum":86400},
    "animationRootBoneName": {"type":"string","minLength":1,"maxLength":120},
    "tracks": {"type":"array","minItems":1,"maxItems":256,"items":{"$ref":"#/$defs/track"}},
    "events": {"type":"array","maxItems":256,"items":{"$ref":"#/$defs/event"}}
  },
  "$defs": {
    "track": {"type":"object","additionalProperties":false,"required":["targetBoneName","path","interpolation","keyframes"],"properties":{"targetBoneName":{"type":"string","minLength":1,"maxLength":120},"path":{"enum":["TRANSLATION","ROTATION"]},"interpolation":{"const":"LINEAR"},"keyframes":{"type":"array","minItems":1,"maxItems":10000,"items":{"$ref":"#/$defs/keyframe"}}}},
    "keyframe": {"type":"object","additionalProperties":false,"required":["timeSeconds","value"],"properties":{"timeSeconds":{"type":"number","minimum":0,"maximum":86400},"value":{"type":"array","minItems":3,"maxItems":4,"items":{"type":"number","minimum":-1000000,"maximum":1000000}}}},
    "event": {"type":"object","additionalProperties":false,"required":["timeSeconds","name"],"properties":{"timeSeconds":{"type":"number","minimum":0,"maximum":86400},"name":{"type":"string","minLength":1,"maxLength":31,"pattern":"^[\\x00-\\x7F]+$"}}}
  }
}
