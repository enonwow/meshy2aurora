{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meshy2aurora.local/contracts/community-animation-manifest-v1.schema.json",
  "title": "Meshy2Aurora community animation manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","presetId","presetVersion","outputName","label","summary","source","authors","license","tags","playback","durationSeconds","rigProfile","rigSignatureSha256","requiredBones","animationPath","animationByteLength","animationSha256","motionSha256","previewPath","previewByteLength","previewSha256","validationStatus"],
  "properties": {
    "schemaVersion": {"const": 1},
    "presetId": {"type":"string","pattern":"^[A-Za-z0-9_-]{1,64}$"},
    "presetVersion": {"type":"integer","minimum":1},
    "outputName": {"type":"string","pattern":"^[A-Za-z0-9_]{1,16}$"},
    "label": {"type":"string","minLength":1,"maxLength":120},
    "summary": {"type":"string","minLength":1,"maxLength":500},
    "source": {"enum":["BUILT_IN","COMMUNITY"]},
    "authors": {"type":"array","minItems":1,"maxItems":16,"items":{"type":"object","additionalProperties":false,"required":["name"],"properties":{"name":{"type":"string","minLength":1,"maxLength":120}}}},
    "license": {"enum":["CC0-1.0","CC-BY-4.0","LicenseRef-Meshy2Aurora-Project-Generated"]},
    "tags": {"type":"array","minItems":1,"maxItems":16,"uniqueItems":true,"items":{"type":"string"}},
    "playback": {"enum":["ONE_SHOT","LOOP"]},
    "durationSeconds": {"type":"number","exclusiveMinimum":0,"maximum":86400},
    "rigProfile": {"type":"string","pattern":"^[A-Za-z0-9_-]{1,64}$"},
    "rigSignatureSha256": {"$ref":"#/$defs/sha256"},
    "requiredBones": {"type":"array","minItems":1,"maxItems":257,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":120}},
    "animationPath": {"const":"animation.json"},
    "animationByteLength": {"type":"integer","minimum":1,"maximum":2097152},
    "animationSha256": {"$ref":"#/$defs/sha256"},
    "motionSha256": {"$ref":"#/$defs/sha256"},
    "previewPath": {"type":["string","null"],"enum":["preview.webp",null]},
    "previewByteLength": {"type":["integer","null"],"minimum":1,"maximum":2097152},
    "previewSha256": {"anyOf":[{"$ref":"#/$defs/sha256"},{"type":"null"}]},
    "validationStatus": {"enum":["PIPELINE_VERIFIED","OWNER_NWN_VERIFIED"]}
  },
  "$defs": {"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
