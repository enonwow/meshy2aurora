/target/
.codex-tmp/
/.codex-remote-attachments/
/.worktrees/
/.tmp/
# Literal directory left by Windows tooling with an unexpanded variable.
/%SystemDrive%/
**/.playwright-cli/
/tmp/
/output/
**/pkg/
node_modules/
dist/
*.tsbuildinfo
apps/studio-web/tests/.generated/
apps/studio-web/tests/browser/__screenshots__/
apps/studio-web/.vitest-attachments/
coverage/
playwright-report/
test-results/
*.tmp
*.log

# Python bytecode and local virtual environments.
__pycache__/
*.py[cod]
.venv/
venv/

# Temporary output from the NWN script compiler.
/NWNScriptCompilerTempScript.ncs

# Local credentials and environment.
.env
.env.*
!.env.example
*.pem
*.keytab
*.pfx

# Operating-system metadata.
.DS_Store
Thumbs.db
Desktop.ini

# Local proof payloads are generated or selected at runtime and are never fixtures.
/artifacts/
/proof-output/
/local-reference-assets/
*.hak
*.mod

# Owner-selected Meshy source payloads are local; tracked manifests live beside them.
/sample-3d/**/*.glb
/sample-3d/**/*.gltf
/sample-3d/**/*.fbx
/sample-3d/**/*.zip
/sample-3d/**/*.bin
